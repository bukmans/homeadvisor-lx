# ─── HomeAdvisor LX — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it is already in .gitignore

# ── Claude API ──────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
VITE_CLAUDE_API_KEY=your_claude_api_key_here

# ── EmailJS (for automated email delivery) ──────────────────────────────────────
# Sign up free at: https://emailjs.com
# 1. Create a service (Gmail, Outlook, etc.)
# 2. Create an email template — use these variable names:
#    {{to_email}}, {{to_name}}, {{household}}, {{income}}, {{purchase_price}},
#    {{loan_amount}}, {{loan_term}}, {{bellegen_akt}}, {{capital_grant}},
#    {{subsidy_rate}}, {{monthly_gross}}, {{monthly_net}}, {{monthly_saving}},
#    {{effective_rate}}, {{dti_after_aid}}, {{total_savings}}, {{lifetime_saving}},
#    {{net_cost}}, {{ai_narrative}}, {{generated_date}}
# 3. Copy your Service ID, Template ID, and Public Key below

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
